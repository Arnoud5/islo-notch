// Vector icons drawn with Slint paths (no image files, nothing to load at runtime).
// All icons use a 24x24 viewbox so they scale crisply at any DPI.

export component Icon inherits Path {
    in property <string> d;
    commands: d;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: white;
    stroke-width: 0px;
}

/// Line-style glyph (the design's shelf / check / arrow icons are stroked).
export component LineIcon inherits Path {
    in property <string> d;
    in property <brush> ink: white;
    in property <length> weight: 1.6px;
    commands: d;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: transparent;
    stroke: ink;
    stroke-width: weight;
}

