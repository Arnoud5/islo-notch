// ---------------- Islo brand (Mochi) ----------------
// Paths copied from the Islo design system's Logos group (64-unit artboard).

/// Full mark, with the notch shoulders. 24px and up.
/// Light grounds: black head, pet-yellow eyes (islo-mark).
/// Dark grounds: white head, black eyes (islo-mark-inverse).
export component BrandMark inherits Rectangle {
    in property <bool> on-dark: false;
    width: 32px;
    height: 32px;
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 64;
        viewbox-height: 64;
        fill: root.on-dark ? #ffffff : #000000;
        commands: "M6 24H16.6L21.2 11.6Q22 9.6 23.4 11.2L30 20.2Q32 22 34 20.2L40.6 11.2Q42 9.6 42.8 11.6L47.4 24H58A6 6 0 0 0 52 30V37A14 14 0 0 1 38 51H26A14 14 0 0 1 12 37V30A6 6 0 0 0 6 24Z";
    }
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 64;
        viewbox-height: 64;
        fill: root.on-dark ? #000000 : #d3b63b;
        commands: "M21.6 37.5a3.4 3.4 0 1 0 6.8 0a3.4 3.4 0 1 0-6.8 0zM35.6 37.5a3.4 3.4 0 1 0 6.8 0a3.4 3.4 0 1 0-6.8 0z";
    }
}

/// Mochi, the Islo mascot and pet: the brand's small drawing (chunkier ears,
/// bigger eyes, no shoulders). Colors come from a skin so they can be customized.
/// `orient`: 0 upright, 1 upside down (hanging below an edge), 2 ears to the left,
/// 3 ears to the right (peeking around a side). `look-x/y` (-1..1) move the eyes.
export component Mochi inherits Rectangle {
    in property <brush> head: #000000;
    in property <brush> eyes: #d3b63b;
    in property <bool> awake: true;
    in property <float> look-x: 0;
    in property <float> look-y: 0;
    in property <float> blink: 0; // 0 open .. 1 shut
    in property <int> orient: 0;
    width: 20px;
    height: 20px;
    // px per drawing unit (the artboard is 56 units, starting at 4)
    property <length> u: self.width / 56;
    property <length> er: 4.6 * u;              // eye radius
    property <length> reach: 3.4 * u;           // how far the eyes can look
    // eye centers per orientation, in drawing units
    property <float> e1x: orient == 0 || orient == 1 ? 24.5 : orient == 2 ? 37 : 27;
    property <float> e1y: orient == 0 ? 37 : orient == 1 ? 27 : orient == 2 ? 39.5 : 24.5;
    property <float> e2x: orient == 0 || orient == 1 ? 39.5 : orient == 2 ? 37 : 27;
    property <float> e2y: orient == 0 ? 37 : orient == 1 ? 27 : orient == 2 ? 24.5 : 39.5;
    property <length> lx: clamp(look-x, -1, 1) * reach;
    property <length> ly: clamp(look-y, -1, 1) * reach;
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-x: 4;
        viewbox-y: 4;
        viewbox-width: 56;
        viewbox-height: 56;
        fill: root.head;
        commands: root.orient == 1 ? "M10 40L15 40L20 54Q21.5 56.5 23 54L28.5 45L35.5 45L41 54Q42.5 56.5 44 54L49 40L54 40L54 28A15 15 0 0 0 39 13L25 13A15 15 0 0 0 10 28Z"
            : root.orient == 2 ? "M24 54L24 49L10 44Q7.5 42.5 10 41L19 35.5L19 28.5L10 23Q7.5 21.5 10 20L24 15L24 10L36 10A15 15 0 0 1 51 25L51 39A15 15 0 0 1 36 54Z"
            : root.orient == 3 ? "M40 10L40 15L54 20Q56.5 21.5 54 23L45 28.5L45 35.5L54 41Q56.5 42.5 54 44L40 49L40 54L28 54A15 15 0 0 1 13 39L13 25A15 15 0 0 1 28 10Z"
            : "M10 24L15 24L20 10Q21.5 7.5 23 10L28.5 19L35.5 19L41 10Q42.5 7.5 44 10L49 24L54 24L54 36A15 15 0 0 1 39 51L25 51A15 15 0 0 1 10 36Z";
    }
    // Eyes: open circles that follow the pointer; asleep they become soft lids.
    property <length> eh: root.awake ? max(1.2px, 2 * er * (1 - 0.85 * clamp(blink, 0, 1))) : max(1.2px, er * 0.42);
    Rectangle {
        x: (root.e1x - 4) * u - er + (root.awake ? lx : 0);
        y: (root.e1y - 4) * u - eh / 2 + (root.awake ? ly : er * 0.3);
        width: 2 * er;
        height: eh;
        border-radius: min(er, eh / 2);
        background: root.eyes;
    }
    Rectangle {
        x: (root.e2x - 4) * u - er + (root.awake ? lx : 0);
        y: (root.e2y - 4) * u - eh / 2 + (root.awake ? ly : er * 0.3);
        width: 2 * er;
        height: eh;
        border-radius: min(er, eh / 2);
        background: root.eyes;
    }
}
