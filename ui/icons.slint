    // filled
    out property <string> play: "M7 4.5v15L19.5 12z";
    out property <string> pause: "M7 5h3.5v14H7zM13.5 5H17v14h-3.5z";
    out property <string> next: "M16 5h2v14h-2zM4 5v14l11-7z";
    out property <string> prev: "M6 5h2v14H6zM20 5v14L9 12z";
    out property <string> note: "M19 3.5v11.25a3.25 3.25 0 1 1-2-3V7.6l-8 1.9v7.25a3.25 3.25 0 1 1-2-3V6.3a1 1 0 0 1 .77-.97l10-2.37A1 1 0 0 1 19 3.5z";
    out property <string> speaker: "M3 9h4l5-4v14l-5-4H3zM15 8.5a5 5 0 0 1 0 7l-1.4-1.4a3 3 0 0 0 0-4.2zM17.8 5.7a9 9 0 0 1 0 12.6l-1.4-1.4a7 7 0 0 0 0-9.8z";
    out property <string> speaker-mute: "M3 9h4l5-4v14l-5-4H3zM14.3 9.1l1.4-1.4 2.3 2.3 2.3-2.3 1.4 1.4-2.3 2.3 2.3 2.3-1.4 1.4-2.3-2.3-2.3 2.3-1.4-1.4 2.3-2.3z";
    out property <string> sun: "M12 7.5a4.5 4.5 0 1 1 0 9 4.5 4.5 0 0 1 0-9zM11 1h2v4h-2zM11 19h2v4h-2zM1 11h4v2H1zM19 11h4v2h-4zM4.2 5.6l1.4-1.4 2.8 2.8-1.4 1.4zM15.6 17l1.4-1.4 2.8 2.8-1.4 1.4zM4.2 18.4l2.8-2.8 1.4 1.4-2.8 2.8zM15.6 7l2.8-2.8 1.4 1.4-2.8 2.8z";
