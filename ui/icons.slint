    out property <string> gear: "M10.3 2h3.4l.5 2.6c.6.2 1.2.55 1.7.95l2.5-.9 1.7 2.95-2 1.75c.1.6.1 1.2 0 1.8l2 1.75-1.7 2.95-2.5-.9c-.5.4-1.1.75-1.7.95l-.5 2.6h-3.4l-.5-2.6a6.5 6.5 0 0 1-1.7-.95l-2.5.9-1.7-2.95 2-1.75a5.6 5.6 0 0 1 0-1.8l-2-1.75 1.7-2.95 2.5.9c.5-.4 1.1-.75 1.7-.95zM12 8.75a3.25 3.25 0 1 0 0 6.5 3.25 3.25 0 0 0 0-6.5z";
    out property <string> bell: "M12 3a6 6 0 0 0-6 6v3.5L4.5 15v1.5h15V15L18 12.5V9a6 6 0 0 0-6-6zM9.8 18.5a2.2 2.2 0 0 0 4.4 0z";
    out property <string> lyrics: "M4 6h16v2H4zM4 11h12v2H4zM4 16h9v2H4z";
    out property <string> close: "M6.4 5 12 10.6 17.6 5 19 6.4 13.4 12 19 17.6 17.6 19 12 13.4 6.4 19 5 17.6 10.6 12 5 6.4z";
    // line (stroked)
    out property <string> shelf: "M3.75 13.5h4.5l1.5 2.25h4.5l1.5-2.25h4.5M3.75 13.5 6 5.25h12l2.25 8.25v5.25H3.75z";
    out property <string> check: "m5 12.5 4.5 4.5L19 7.5";
    out property <string> drop-arrow: "M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 19.25h14";
